{
  "manifest_version": 3,
  "name": "Instagram Grayscale",
  "version": "1.2.0",
  "description": "Turns Instagram completely grayscale to reduce visual distractions.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}